@model IEnumerable<ASPBeauty.Data.Product>

@{
    ViewData["Title"] = "Каталог";
}

<div class="products-page">

    <h1 class="products-title">Нашите продукти</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="create-btn-container">
            <a asp-action="Create" class="create-product-btn">
                + Добави продукт
            </a>
        </div>
    }

    <div class="products-grid">

        @foreach (var item in Model)
        {
            <div class="product-card">

                <img src="@item.ImageURL"
                     alt="@item.Name"
                     class="product-image" />

                <div class="product-info">

                    <h3>@item.Name</h3>

                    <p class="product-category">
                        @item.Type.Name
                    </p>

                    <p class="product-price">
                        @item.Price €.
                    </p>

                    <div class="product-buttons">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="details-btn">
                            Детайли
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="edit-btn">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="delete-btn">
                                Delete
                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>