<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Красота</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/ASPBeauty.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand krasota-logo" asp-area="" asp-controller="Home" asp-action="Index">Красота</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center gap-2">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Начало
                            </a>
                        </li>


                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               data-bs-toggle="dropdown">
                                Грижа за кожата
                            </a>

                            <ul class="dropdown-menu">
                                @if (ViewBag.Types != null)
                                {
                                    @foreach (var type in ViewBag.Types)
                                    {
                                        if (!type.Name.ToLower().Contains("грим") &&
                                        !type.Name.ToLower().Contains("очи") &&
                                        !type.Name.ToLower().Contains("вежди") &&
                                        !type.Name.ToLower().Contains("устни"))
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Products"
                                                   asp-action="Index"
                                                   asp-route-typeId="@type.Id">
                                                    @type.Name
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </li>


                        <!-- SKINCARE -->
                        <ul class="dropdown-menu">
                            @if (ViewBag.Types != null)
                            {
                                foreach (var type in ViewBag.Types)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Products"
                                           asp-action="Index"
                                           asp-route-typeId="@type.Id">
                                            @type.Name
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                        </li>

                        <!-- MAKEUP -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               data-bs-toggle="dropdown">
                                Грим
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Products"
                                       asp-action="Index"
                                       asp-route-typeId="6">
                                        Грим за лице
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Products"
                                       asp-action="Index"
                                       asp-route-typeId="7">
                                        Грим за очи
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Products"
                                       asp-action="Index"
                                       asp-route-typeId="8">
                                        Вежди
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Products"
                                       asp-action="Index"
                                       asp-route-typeId="9">
                                        Устни
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Products"
                               asp-action="Index">
                                Каталог
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Promotions">
                                Промоции
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Contacts">
                                Контакти
                            </a>
                        </li>

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ASPBeauty - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




