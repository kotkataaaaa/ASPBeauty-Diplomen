@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@using ASPBeauty.Data
@model IEnumerable<Cart>

@{
    ViewData["Title"] = "Количка";
}

<div class="container py-5">

    <h1 class="text-center mb-5">🛒 Моята количка</h1>

    @if (!Model.Any())
    {
        <div class="text-center">

            <h4>Количката е празна</h4>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-dark mt-3">
                Към продуктите
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow border-0 h-100">

                        <div class="card-body text-center">
                            <img src="@item.Product.ImageURL"
                                 class="img-fluid rounded mb-3"
                                 style="height:250px; object-fit:cover;" />
                            <h4 class="mb-3">
                                @item.Product.Name
                            </h4>

                            <h5 class="text-muted mb-4">
                                @item.Product.Price лв.
                            </h5>
                            <p class="fw-bold">
                                Количество: @item.Quantity
                            </p>
                            <div class="d-flex justify-content-center gap-2">

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-outline-danger">
                                        Премахни
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="text-center mt-5">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-dark btn-lg me-2">
                Продължи пазаруването
            </a>

            <form asp-action="Order" method="post">

                <button type="submit"
                        class="btn btn-dark">
                    Поръчай
                </button>

            </form>
        </div>
    }

</div>